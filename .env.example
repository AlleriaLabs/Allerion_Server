# Required API bearer token. Replace with a long random value before deployment.
TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Set false after password setup to disable legacy X-Token API access.
# New installations created by install.sh default to false.
LEGACY_TOKEN_AUTH=true

# Optional monitoring and integrations
SERVICE_CHECKS=
ENABLE_LAN_DISCOVERY=1
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firebase Cloud Messaging (free push delivery; keep the service-account JSON outside Git)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json

# Alert thresholds
ALERT_CPU_THRESHOLD=90
ALERT_RAM_THRESHOLD=90
ALERT_TEMP_THRESHOLD=85
ALERT_DISK_THRESHOLD=92
