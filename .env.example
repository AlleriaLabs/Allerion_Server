# The installer generates a random TOKEN automatically; do not reuse this example value.
TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# New installations use password sessions; enable only for a controlled legacy migration.
LEGACY_TOKEN_AUTH=false
ALLERION_IMAGE=ghcr.io/allerialabs/allerion-server:latest
PORT=8081
TZ=Asia/Manila

# Optional monitoring and integrations
SERVICE_CHECKS=
ENABLE_LAN_DISCOVERY=1
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_ANALYTICS_INTERVAL=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json

# Alert thresholds
ALERT_CPU_THRESHOLD=90
ALERT_RAM_THRESHOLD=90
ALERT_TEMP_THRESHOLD=85
ALERT_DISK_THRESHOLD=92
PRICE_PER_KWH=0
CURRENCY=PHP
BASE_WATTS=0
